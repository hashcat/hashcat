  KEYSET13 DES_EVEN
  KEYSET14 DES_ODD_LO DES_ODD_HI
  KEYSET15 DES_EVEN
  KEYSET16 DES_ODD_LO DES_ODD_HI
  KEYSET17 DES_EVEN
}

// the same rounds with the sixteen keys in reverse

DECLSPEC void krb5_des_bs_decrypt (PRIVATE_AS const u32 *K, PRIVATE_AS u32 *D)
{
  KXX_DECL u32 k00, k01, k02, k03, k04, k05;
  KXX_DECL u32 k06, k07, k08, k09, k10, k11;
  KXX_DECL u32 k12, k13, k14, k15, k16, k17;
  KXX_DECL u32 k18, k19, k20, k21, k22, k23;
  KXX_DECL u32 k24, k25, k26, k27, k28, k29;
  KXX_DECL u32 k30, k31, k32, k33, k34, k35;
  KXX_DECL u32 k36, k37, k38, k39, k40, k41;
  KXX_DECL u32 k42, k43, k44, k45, k46, k47;

  KEYSET17 DES_ODD_LO DES_ODD_HI
  KEYSET16 DES_EVEN
  KEYSET15 DES_ODD_LO DES_ODD_HI
  KEYSET14 DES_EVEN
  KEYSET13 DES_ODD_LO DES_ODD_HI
  KEYSET12 DES_EVEN
  KEYSET11 DES_ODD_LO DES_ODD_HI
  KEYSET10 DES_EVEN
  KEYSET07 DES_ODD_LO DES_ODD_HI
  KEYSET06 DES_EVEN
  KEYSET05 DES_ODD_LO DES_ODD_HI
  KEYSET04 DES_EVEN
  KEYSET03 DES_ODD_LO DES_ODD_HI
  KEYSET02 DES_EVEN
  KEYSET01 DES_ODD_LO DES_ODD_HI
  KEYSET00 DES_EVEN
}

