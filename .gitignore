# tools/test.sh names its working directory test_<unix timestamp> and leaves it in the repository
# root. Anchored and restricted to digits on purpose: a bare test_* would also match
# tools/test_modules/ and hide every new test module from git.
/test_[0-9]*/

# tools/compute_sanitizer: the DEBUG=1 sibling binary, per-run results
# (never overwritten, so never something to commit), and the compiled
# ground-truth .cu fixtures (source is tracked, the nvcc-built binaries are not).
/hashcat-sanitizer
/tools/compute_sanitizer/results/
/tools/compute_sanitizer/modules/oob_write
/tools/compute_sanitizer/modules/oob_read
/tools/compute_sanitizer/modules/uninit_global

Rust/feeds/*/target
Rust/bridges/*/target

# Left behind by builds from before the bindings moved into OUT_DIR
Rust/hashcat-sys/src/bindings.rs

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Generated docs are overwritten anyway
/docs/hashcat-example_hashes.md
/docs/hashcat-help.md
