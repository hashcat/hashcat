+
+		for (i = 0; i < s->channels; i++) {
+			chan = &s->chan[i];
+			/* dma reader interrupt handling */
+			if (irq_vector & (1 << chan->dma.reader_interrupt)) {
+				loop_status = litepcie_readl(s, chan->dma.base +
