+/* Arm one batch of descriptors on a table left in Prog mode.
+ *
+ * This is the per-transfer operation, and it resets the table before programming it, so a caller does
+ * not have to stop and restart the engine between batches to get a clean count. Stopping costs two
+ * udelay(1000) calls, which at a small batch is most of the transfer.
+ *
+ * The reset is safe here precisely because the previous batch has finished: in Prog mode the table
+ * drains and the DMA stops, so there is nothing in flight to tear up. The table is a FIFO of
+ * DMA_BUFFER_COUNT entries, so a batch can be at most that deep, and buffers are always taken from the
+ * start of the ring, which is where the counters are put back to.
+ *
+ * last_length shortens the final descriptor. That is what makes a transfer of a partial buffer possible:
+ * in loop mode the writer only completes a descriptor once a whole DMA_BUFFER_SIZE has arrived, so a
+ * batch had to be a whole number of buffers or the remainder stayed in the device.
+ *
+ * THE TABLE IS NOT THE ONLY PLACE A DESCRIPTOR LIVES, AND FLUSHING IT IS NOT A RESET.
+ *
+ * LitePCIeDMADescriptorSplitter takes the descriptor at the head of the table into registers of its
+ * own as soon as it is idle and one is available, and it pops the table entry only once that
+ * descriptor has been executed. So a transfer that does not consume the whole table ends with the
+ * splitter already holding the address of the NEXT buffer, and a table flush cannot touch it: the
+ * flush empties a FIFO the splitter has already read from.
+ *
+ * Arm again and the first data of the new transfer is written to that stale address, while the
+ * descriptor the host armed first is popped and discarded without being written. Every buffer of the
+ * transfer is then off by one and the last one never completes, so its data is never delivered.
+ *
+ * The splitter is held in reset while the engine is disabled, which is exactly why
+ * litepcie_dma_writer_start disables before it programs the table and enables afterwards. Arming is
+ * that same operation done per transfer, so it does the same two writes. The readback is what makes
+ * the order real: a posted write can still be in flight while the descriptors behind it are being
+ * programmed.
+ */
+static int litepcie_dma_arm(struct litepcie_device *s, int chan_num, bool is_writer, uint32_t count, uint32_t last_length)
+{
+	struct litepcie_dma_chan *dmachan;
+	uint32_t i, base, value_off, we_off, enable_off, length;
+	dma_addr_t handle;
+
+	dmachan = &s->chan[chan_num].dma;
+
+	if (!dmachan->oneshot)
+		return -EINVAL;
+
+	if (count == 0 || count > DMA_BUFFER_COUNT)
+		return -EINVAL;
+
+	if (last_length > DMA_BUFFER_SIZE)
+		return -EINVAL;
+
+	base = dmachan->base;
+
+	if (is_writer) {
+		value_off  = base + PCIE_DMA_WRITER_TABLE_VALUE_OFFSET;
+		we_off     = base + PCIE_DMA_WRITER_TABLE_WE_OFFSET;
+		enable_off = base + PCIE_DMA_WRITER_ENABLE_OFFSET;
+	} else {
+		value_off  = base + PCIE_DMA_READER_TABLE_VALUE_OFFSET;
+		we_off     = base + PCIE_DMA_READER_TABLE_WE_OFFSET;
+		enable_off = base + PCIE_DMA_READER_ENABLE_OFFSET;
+	}
+
+	/* Stop the engine, so the splitter drops whatever it is holding. See above. */
+	litepcie_writel(s, enable_off, 0);
+	litepcie_readl(s, enable_off);
+
+	if (is_writer) {
+		/* Resetting the table zeroes the hardware loop index and count, so the software counters
+		 * have to go back with it or the next interrupt reads a step backwards and the wrap
+		 * detection adds a spurious 2^32.
+		 */
+		litepcie_writel(s, base + PCIE_DMA_WRITER_TABLE_FLUSH_OFFSET, 1);
+
+		dmachan->writer_hw_count      = 0;
+		dmachan->writer_hw_count_last = 0;
+		dmachan->writer_sw_count      = 0;
+	} else {
+		litepcie_writel(s, base + PCIE_DMA_READER_TABLE_FLUSH_OFFSET, 1);
+
+		dmachan->reader_hw_count      = 0;
+		dmachan->reader_hw_count_last = 0;
+		dmachan->reader_sw_count      = 0;
+	}
+
+	for (i = 0; i < count; i++) {
+		handle = is_writer ? dmachan->writer_handle[i] : dmachan->reader_handle[i];
+
+		length = DMA_BUFFER_SIZE;
+		if (i == count - 1 && last_length != 0)
+			length = last_length;
+
+		/* An MSI on every descriptor, not every DMA_BUFFER_PER_IRQ as in loop mode.
+		 *
+		 * The interrupt is what makes progress trustworthy. The table's loop status advances when a
+		 * descriptor is handed to the splitter, which is issue time, so a buffer it has passed may
+		 * still be in flight. The MSI is a posted write ordered behind the data writes of the same
+		 * descriptor, so by the time the handler runs that buffer has landed. Software that wants a
+		 * safe frontier has to use the interrupt-updated count, and one interrupt per buffer is what
+		 * lets it consume a batch as it arrives instead of only at the end.
+		 *
+		 * One interrupt per buffer is far below anything that matters here: a batch takes hundreds
+		 * of milliseconds and produces a few dozen buffers.
+		 */
+		litepcie_writel(s, value_off,
+#ifndef DMA_BUFFER_ALIGNED
+			DMA_LAST_DISABLE |
+#endif
+			length);
+		litepcie_writel(s, value_off + 4, (handle >>  0) & 0xffffffff);
+		litepcie_writel(s, we_off,        (handle >> 32) & 0xffffffff);
+	}
+
+	/* Start it again, on a table that now holds this transfer and nothing else. */
+	litepcie_writel(s, enable_off, 1);
+
+	return 0;
+}
