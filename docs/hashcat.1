.B \-3, \-\-custom\-charset3 " CS"
User\-defined charset ?3
.TP
.B \-4, \-\-custom\-charset4 " CS"
User\-defined charset ?4
.TP
.B \-5, \-\-custom\-charset5 " CS"
User\-defined charset ?5
.TP
.B \-6, \-\-custom\-charset6 " CS"
User\-defined charset ?6
