# Rule commands, one entry per command, as tools/fuzz/fuzz_rule.c consumes
# them. Operands are included where a command takes one, so the fuzzer starts
# from a well formed command and mutates the operand rather than spending
# executions rediscovering which bytes are commands at all.

":"
"l"
"u"
"c"
"C"
"t"
"T0"
"r"
"d"
"p2"
"f"
"{"
"}"
"$a"
"^a"
"["
"]"
"D1"
"x12"
"O12"
"i1a"
"o1a"
"'5"
"sab"
"@a"
"z2"
"Z2"
"q"
"k"
"K"
"*12"
"L1"
"R1"
"+1"
"-1"
".1"
",1"
"y2"
"Y2"
"E"
"ea"
"31a"
"%2a"
"4"
"6"
"M"
"Q"
"X123"

# multibyte operands, which is where rule_utf8_len decides how many bytes the
# operand occupies

"$\xc3\xa9"
"^\xe2\x82\xac"
"$\xf0\x9f\x98\x80"
"i0\xc3\xa9"
