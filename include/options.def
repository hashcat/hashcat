// One row per command line option. The option table builds the long options and the short option
// string getopt reads from these rows, in this order.
//
//   OPTION (id, long name, short letter or 0, getopt value, getopt argument kind)
//
// The file is included with OPTION defined to whatever the includer needs from a row. What an option
// is allowed to do lives in option_rules[] in src/user_options_table.c, indexed by the id.
//
// An option that only some hash-modes read is not listed here. The modules that read it register it,
// see module_register_options () and src/module_options.c.

OPTION (OPT_ADVICE_DISABLE,            "advice-disable",            0,   IDX_ADVICE_DISABLE,            no_argument)
OPTION (OPT_ATTACK_MODE,               "attack-mode",               'a', IDX_ATTACK_MODE,               required_argument)
