FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

## Change to bash

RUN echo "dash dash/sh boolean false" | debconf-set-selections && dpkg-reconfigure dash

# libclang-dev is here for its libclang, which bindgen loads at build time to generate the
# hashcat-sys bindings. Without it the Rust bridges fail with "Unable to find libclang".
# lld is here because the Windows Rust plugin is linked with -fuse-ld=lld, and without
# it the cross build stops at "collect2: fatal error: cannot find 'ld'"
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    build-essential \
    git \
    libclang-dev \
    lld \
    wget \
    pkg-config \
    make \
    gcc-mingw-w64-x86-64 \
    g++-mingw-w64-x86-64 \
    dos2unix \
    libssl-dev \
    zlib1g-dev \
    libncurses5-dev \
    libncursesw5-dev \
    libreadline-dev \
    libsqlite3-dev \
    libgdbm-dev \
    libdb5.3-dev \
    libbz2-dev \
    libexpat1-dev \
    liblzma-dev tk-dev \
    unzip \
    zstd \
    curl \
    tar

WORKDIR /root

## Ubuntu 20.04 cmake version is incompatible to recent win-iconv so we use our own
RUN wget https://github.com/Kitware/CMake/releases/download/v3.25.3/cmake-3.25.3-linux-x86_64.sh && \
    chmod +x cmake-3.25.3-linux-x86_64.sh && \
    ./cmake-3.25.3-linux-x86_64.sh --skip-license --prefix=/usr/local

## Also 7z on ubuntu 20.04 is very outdated
WORKDIR /root
RUN git clone --branch 24.09 https://github.com/ip7z/7zip.git
WORKDIR /root/7zip/CPP/7zip/Bundles/Alone2
RUN make -f makefile.gcc -j
RUN cp /root/7zip/CPP/7zip/Bundles/Alone2/_o/7zz /usr/local/bin/7z

## Iconv for windows
WORKDIR /root
RUN git clone --branch v0.0.10 https://github.com/win-iconv/win-iconv.git

WORKDIR /root/win-iconv
RUN cmake \
    -D WIN_ICONV_BUILD_EXECUTABLE=OFF \
    -D CMAKE_INSTALL_PREFIX=/opt/win-iconv-64 \
    -D CMAKE_C_COMPILER=$(which x86_64-w64-mingw32-gcc) \
    -D CMAKE_CXX_COMPILER=$(which x86_64-w64-mingw32-g++) \
    . && \
    make install

## Ubuntu 20.04: Python version 3.10 is too old, it lacks support for non-GIL mode

WORKDIR /root

ENV PYTHON_VERSION=3.14.6

RUN wget https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz && \
    tar xzf Python-${PYTHON_VERSION}.tgz

WORKDIR /root/Python-${PYTHON_VERSION}

RUN ./configure --prefix=/opt/linux-python && \
    make -j && make install

ENV PATH="/opt/linux-python/bin:$PATH"

## Ubuntu 20.04: Rust is also too old, let's fetch a fresh one

WORKDIR /root

RUN curl https://sh.rustup.rs -sSf | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"
RUN rustup target add x86_64-pc-windows-gnu

## For Windows we also need python

WORKDIR /root

RUN mkdir /opt/win-python
WORKDIR /opt/win-python
RUN wget https://repo.msys2.org/mingw/mingw64/mingw-w64-x86_64-python-3.14.6-2-any.pkg.tar.zst
RUN unzstd mingw-w64-x86_64-python-3.14.6-2-any.pkg.tar.zst
RUN tar -xf mingw-w64-x86_64-python-3.14.6-2-any.pkg.tar

## Custom patches

WORKDIR /root

COPY docker/patches/ubuntu20/ /root/patches/

# the tree the package is built from. A clone of master names no particular commit, so what a past
# release was built from cannot be got back and that release cannot be rebuilt. A tag or a commit
# is named here instead, and another one is asked for with --build-arg HASHCAT_REF=<ref>. It is
# bumped with the version in tools/package_bin.sh, which is edited for the same release anyway.

ARG HASHCAT_REF=v7.1.2

RUN git clone https://github.com/hashcat/hashcat.git && git -C hashcat checkout --detach ${HASHCAT_REF}

WORKDIR /root/hashcat

RUN bash -c 'shopt -s nullglob; for p in /root/patches/*.patch /root/patches/*.diff; do pwd && git apply "$p"; done'

RUN make -s binaries

RUN tools/package_bin.sh

# What the runtime images copy out. It is the package rather than this build tree, so what they run
# is the layout that ships: the frontend beside the core, every plugin one directory below it, and
# none of the sources or the git checkout. package_bin.sh names its output after the version and
# leaves the .7z beside it, and a COPY --from cannot tell the directory from the archive with a
# glob, so the package is given a fixed name here where a shell can.

RUN mkdir /root/package && cp -a /root/xy/hashcat-*/. /root/package/

RUN ["/bin/bash"]
